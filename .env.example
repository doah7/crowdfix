# 복사해서 .env 로 쓰면 docker compose 가 읽는다. 없어도 기본값으로 동작한다.

# JWT 서명 키 (공개 서버에 올릴 때는 꼭 바꾼다)
JWT_SECRET=change-me-demo-only

# 자동 전달 기준값 T (SRS BR-07). 시연은 3, 실제 운영은 Issue 20 / Proposal 30
THRESHOLD_ISSUE=3
THRESHOLD_PROPOSAL=3

# 보고서 메일 (시연에서는 mailpit 시험 수신함으로 간다: http://localhost:8025)
REPORT_MAIL_FROM=crowdfix@demo.local
